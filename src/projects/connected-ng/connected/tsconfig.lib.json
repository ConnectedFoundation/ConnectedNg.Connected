/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
	"extends": "../../../tsconfig.json",
	"compilerOptions": {
		"outDir": "../../../out-tsc/lib",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"types": ["@angular/localize"],
		"paths": {
			"@connected-ng/connected": ["../../../dist/connected-ng/connected"],
			"@connected-ng/connected/*": [
				"../../../dist/connected-ng/connected/*"
			],
			"@connected-ng/core": [
				"../../../../../ConnectedNg.Core/src/dist/connected-ng/core"
			],
			"@connected-ng/core/*": [
				"../../../../../ConnectedNg.Core/src/dist/connected-ng/core/*"
			],
			"@connected-ng/components": [
				"../../../../../ConnectedNg.Components/src/dist/connected-ng/components"
			],
			"@connected-ng/components/*": [
				"../../../../../ConnectedNg.Components/src/dist/connected-ng/components/*"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"users/src/**/*.ts",
		"permissions/src/**/*.ts",
		"permission-management/src/**/*.ts"
	],
	"exclude": ["**/*.spec.ts"]
}
