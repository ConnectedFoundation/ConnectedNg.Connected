{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "@connected-ng/Connected": {
            "projectType": "library",
            "root": "projects/connected-ng/connected",
            "sourceRoot": "projects/connected-ng/connected/src",
            "prefix": "cn",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/connected-ng/connected/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/connected-ng/connected/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular/build:karma",
                    "options": {
                        "tsConfig": "projects/connected-ng/connected/tsconfig.spec.json"
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": false
    }
}